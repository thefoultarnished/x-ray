{
  "manifest_version": 3,
  "name": "X-Ray for Twitter (X Location Viewer)",
  "version": "2.1",
  "description": "Reveals location and platform info for Twitter/X users. See where they tweet from and what device they use.",
  "minimum_chrome_version": "130",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X-Ray for Twitter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "ruleset_1", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [
    { "resources": ["parser.js"], "matches": ["https://x.com/*", "https://twitter.com/*"], "use_dynamic_url": true }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["inject-parser.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["saved-results.js", "settings.js", "flags.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self'"
  }
}
